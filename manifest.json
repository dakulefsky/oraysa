{
  "schemaVersion": 1,
  "id": "com.dakulefsky.oraysa-daily",
  "name": "אורייתא יומי",
  "version": "1.2.0",
  "sdkVersion": "1.x",
  "description": "לוח תוכנית אורייתא — עמוד וחזרה, חומרי עזר רשמיים והורדת PDF אוטומטית לשימוש לא מקוון.",
  "author": "dakulefsky",
  "homepage": "https://github.com/dakulefsky/oraysa",
  "stability": "beta",
  "minAppVersion": "0.9.98",
  "entrypoint": "index.html",
  "icon": "icon/icon.png",
  "network": {
    "enabled": true,
    "allowlist": [
      "https://www.oraysa.org",
      "https://oraysa-media.s3.amazonaws.com"
    ]
  },
  "permissions": [
    "library.books.read",
    "library.content.read",
    "reader.open",
    "calendar.read",
    "app.open_url",
    "network.access",
    "fs.user_files.read",
    "app.info.read",
    "plugin.storage.read",
    "plugin.storage.write"
  ],
  "contributes": {
    "toolTab": {
      "title": "אורייתא יומי",
      "order": 320,
      "allowOrderBeforeBuiltIns": false,
      "defaultPinned": true,
      "iconName": "book_open_tzurat_hadaf_24_regular"
    }
  }
}
